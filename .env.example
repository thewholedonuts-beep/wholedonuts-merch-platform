# Development only. Set production values exclusively in the hosting provider's secret store.
NODE_ENV=development
PORT=3001
FRONTEND_URLS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
TRUST_PROXY=0

# PostgreSQL: production requires DATABASE_URL with TLS.
DATABASE_URL=postgres://postgres:replace-me@localhost:5432/wholedonuts_merch
# Optional disposable migrated PostgreSQL database for concurrency tests.
# TEST_DATABASE_URL=postgres://localhost:5432/wholedonuts_merch_test
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SSL_CA=

# Generate distinct random values of at least 32 characters for production.
JWT_SECRET=replace-with-a-development-only-secret
JWT_EXPIRES_IN=8h
SESSION_COOKIE_MAX_AGE_SECONDS=28800
OPERATOR_API_KEY=replace-with-a-development-only-operator-key

# Keep public sponsor registration and referral analytics disabled until explicitly approved.
ALLOW_SPONSOR_SELF_REGISTRATION=false
REFERRAL_ANALYTICS_ENABLED=false
CRUMB_SAVER_REWARDS_ENABLED=false
# Required only when referral analytics are explicitly enabled.
IP_HASH_SALT=replace-with-a-development-only-salt
REWARD_REFERENCE_SALT=replace-with-a-development-only-reward-reference-salt
REWARDS_PRIVACY_NOTICE_VERSION=replace-with-approved-notice-version
REFERRAL_RETENTION_DAYS=365
INTEGRATION_EVENT_RETENTION_DAYS=30

# Shopify store hostname only; never include a protocol or path.
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_ACCESS_TOKEN=replace-with-shopify-admin-api-token
SHOPIFY_WEBHOOK_SECRET=replace-with-shopify-webhook-secret
SHOPIFY_WEBHOOK_TOPICS=orders/create,orders/updated,fulfillments/create,fulfillments/update

# Fulfillment provider credentials are server-side only.
FULFILLMENT_PROVIDERS=printful,printify
DEFAULT_FULFILLMENT_PROVIDER=printful
PRINTFUL_API_KEY=replace-with-printful-api-token
PRINTFUL_API_BASE_URL=https://api.printful.com
PRINTIFY_API_KEY=replace-with-printify-api-token
PRINTIFY_SHOP_ID=replace-with-printify-shop-id
PRINTIFY_API_BASE_URL=https://api.printify.com

RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=1
